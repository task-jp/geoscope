# =====================================================================
# GeoScope 環境変数サンプル
#
# このファイルを .env にコピーして編集してください。
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# データベース
# ---------------------------------------------------------------------
# Postgres スーパーユーザー geoscope のパスワード
DB_PASSWORD=changeme

# ---------------------------------------------------------------------
# JWT 署名キー (必ずランダム長文字列に置き換える)
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------
SECRET_KEY=change-this-to-a-random-string-at-least-32-chars

# ---------------------------------------------------------------------
# DEM タイル
#   GeoScope は z=10〜16 の WebP タイル (Q地図/GSI 互換 RGB エンコード) を
#   `${TILES_DIR}/{z}/{x}/{y}.webp` から読みます。
#   tools/ 以下のスクリプトで GSI DEM1A 等から生成できます。
#   docker-compose.yml のデフォルトは `./tiles` (リポジトリ直下に bind mount)。
# ---------------------------------------------------------------------
TILES_DIR=./tiles

# ---------------------------------------------------------------------
# Google OAuth (https://console.cloud.google.com/apis/credentials)
#   Authorized redirect URI に ${OAUTH_REDIRECT_BASE}/api/auth/google/callback
#   を登録してください。
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth コールバック URL のベース (末尾スラッシュなし)
#   例: http://localhost  (ローカル開発、docker compose で 80 番にアクセス)
#        https://example.com (本番)
OAUTH_REDIRECT_BASE=http://localhost

# ---------------------------------------------------------------------
# ワーカー API
#   後述の RunPod Pod / ローカル Docker worker が backend を叩く際の
#   認証キーのフォールバック。ユーザーごとの個別キー (users.api_key) が
#   通常使われるため、これは空でも構いません。
# ---------------------------------------------------------------------
WORKER_API_KEY=

# ---------------------------------------------------------------------
# RunPod 連携 (BYO クラウドワーカー)
#   ユーザーが自分の RunPod アカウントで Pod を起動します。
#   backend が Pod 起動 API を叩くときに以下の値を使います。
#   RUNPOD_API_KEY はユーザーが UI から送るので環境変数では持ちません。
# ---------------------------------------------------------------------
# 使う Docker イメージ (空ならフォールバック値が cloud_worker.py に定義済)
RUNPOD_IMAGE_NAME=ghcr.io/task-jp/geoscope-worker:latest
# Pod をどのデータセンターで起動するか (カンマ区切り、空=すべて許可)
RUNPOD_DATA_CENTER_IDS=
# 起動を許可する GPU (順位リスト、カンマ区切り)
RUNPOD_GPU_TYPE_IDS=NVIDIA GeForce RTX 4090
# Pod のコンテナディスク (GB)
RUNPOD_CONTAINER_DISK_GB=50

# ---------------------------------------------------------------------
# クラウドワーカー (Pod) → backend のコールバック URL
#   Pod は GEOSCOPE_SERVER/api/worker/... を叩いてジョブを claim します。
#   公開アクセス可能な URL (本番ドメインや ngrok 等) を指定。
#   ローカル開発のみで使うなら local worker (geoscope-worker 別リポ) を推奨。
# ---------------------------------------------------------------------
GEOSCOPE_SERVER=

# DEM タイル配信元 URL (例: Cloudflare R2 の公開バケット)
#   Pod は SKIP_DEM_EXTRACT=true 時にここから個別タイルを HTTP fetch。
#   空にすると Pod 起動時に DEM_TILE_BASE_URL が渡らず、worker は
#   ローカル DEM (Pod 内のファイル) を期待します。
DEM_TILE_BASE_URL=

# Pod の DEM 並列 fetch 数 (推奨 256)
PREFETCH_PARALLEL=256

# ---------------------------------------------------------------------
# Sentry エラー監視 (任意。空なら no-op)
#   https://sentry.io/ でプロジェクトを作って DSN をコピー
# ---------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENV=production

# ---------------------------------------------------------------------
# 学習品質ゲート (worker 側で参照、参考まで)
#   YOLO best mAP50 がこの値未満ならスキャンせずジョブ fail
# ---------------------------------------------------------------------
# MIN_TRAINING_MAP50=0.2

# ---------------------------------------------------------------------
# DB バックアップ用 (scripts/backup_db.sh、cron 実行時に export)
# ---------------------------------------------------------------------
# DB_CONTAINER=geoscope-db-1
# R2_REMOTE_PATH=r2:my-bucket/geoscope-backups/
# RETENTION_DAYS=30
